<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InventarioDomestico.App.ViewModels"
             xmlns:models="clr-namespace:InventarioDomestico.Core.Models;assembly=InventarioDomestico.Core"
             x:Class="InventarioDomestico.App.Views.ProdutosPage"
             x:DataType="vm:ProdutosViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F7F9FC">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12">

        <!-- Barra de Busca -->
        <SearchBar Grid.Row="0"
                   Placeholder="Buscar produto por nome..."
                   Text="{Binding TextoBusca}"
                   CancelButtonColor="#1E88E5"
                   Margin="0,0,0,8" />

        <!-- Seção de Filtros (Categoria, Local e Reposição) -->
        <Frame Grid.Row="1" BackgroundColor="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderColor="#E0E0E0">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Categoria:" FontSize="11" TextColor="#757575" FontAttributes="Bold" />
                        <Picker ItemsSource="{Binding CategoriasFiltro}"
                                SelectedItem="{Binding CategoriaSelecionada}"
                                FontSize="13"
                                Title="Selecione" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Local:" FontSize="11" TextColor="#757575" FontAttributes="Bold" />
                        <Picker ItemsSource="{Binding LocaisFiltro}"
                                SelectedItem="{Binding LocalSelecionado}"
                                FontSize="13"
                                Title="Selecione" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Switch IsToggled="{Binding ApenasReposicao}" VerticalOptions="Center" />
                        <Label Text="Apenas Estoque Baixo / Reposição" FontSize="13" TextColor="#424242" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Button Grid.Column="1"
                            Text="Limpar"
                            Command="{Binding LimparFiltrosCommand}"
                            FontSize="12"
                            TextColor="#1E88E5"
                            BackgroundColor="Transparent"
                            Padding="8,4"
                            HeightRequest="36" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Lista de Produtos -->
        <RefreshView Grid.Row="2" Command="{Binding CarregarProdutosCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Produtos}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="20">
                        <Label Text="🔍" FontSize="48" HorizontalTextAlignment="Center" />
                        <Label Text="Nenhum produto encontrado" FontSize="18" FontAttributes="Bold" TextColor="#424242" HorizontalTextAlignment="Center" />
                        <Label Text="Tente ajustar os filtros ou adicione um novo produto ao estoque." FontSize="14" TextColor="#757575" HorizontalTextAlignment="Center" />
                        <Button Text="➕ Adicionar Novo Produto"
                                Command="{Binding NovoProdutoCommand}"
                                BackgroundColor="#1E88E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Produto">
                        <Frame Margin="0,4,0,6"
                               Padding="14"
                               CornerRadius="10"
                               BackgroundColor="White"
                               BorderColor="{Binding PrecisaReposicao, Converter={StaticResource StockBorderColorConverter}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProdutosViewModel}}, Path=SelecionarProdutoCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                <!-- Nome -->
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nome}" FontSize="16" FontAttributes="Bold" TextColor="#212121" />

                                <!-- Quantidade Atual -->
                                <Frame Grid.Row="0" Grid.Column="1" 
                                       BackgroundColor="{Binding PrecisaReposicao, Converter={StaticResource StockAlertColorConverter}}" 
                                       Padding="8,4" 
                                       CornerRadius="6" 
                                       BorderColor="Transparent">
                                    <Label Text="{Binding QuantidadeFormatada}" FontSize="15" FontAttributes="Bold" TextColor="#1E88E5" />
                                </Frame>

                                <!-- Categoria e Local -->
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                                    <Label Text="{Binding Categoria}" FontSize="12" TextColor="#616161" />
                                    <Label Text="•" FontSize="12" TextColor="#9E9E9E" />
                                    <Label Text="{Binding LocalArmazenamento}" FontSize="12" TextColor="#616161" />
                                </HorizontalStackLayout>

                                <!-- Indicador de Alerta / Estoque Mínimo -->
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                       Text="{Binding StatusEstoqueTexto}" 
                                       FontSize="11" 
                                       FontAttributes="Bold" 
                                       TextColor="{Binding PrecisaReposicao, Converter={StaticResource StockBorderColorConverter}}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
