<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InventarioDomestico.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InventarioDomestico.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Inventário Doméstico">

    <TabBar>
        <Tab Title="Início" Icon="{OnPlatform Android=appicon, Default=appicon}">
            <ShellContent
                Title="Início"
                ContentTemplate="{DataTemplate views:InicioPage}"
                Route="InicioPage" />
        </Tab>

        <Tab Title="Produtos" Icon="{OnPlatform Android=appicon, Default=appicon}">
            <ShellContent
                Title="Produtos"
                ContentTemplate="{DataTemplate views:ProdutosPage}"
                Route="ProdutosPage" />
        </Tab>
    </TabBar>

</Shell>
